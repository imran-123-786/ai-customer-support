# ========================================================
# SupportAgent AI Configuration
# ========================================================

# LLM Provider Selection: 'mock' (offline demo), 'ollama', 'openai', 'gemini'
LLM_PROVIDER=mock

# Local Ollama Settings (Optional)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=30

# Optional Cloud API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Autonomous Agent Engine Parameters
MAX_AGENT_STEPS=6
AGENT_PROMPT_VERSION=v1.2
RECENT_MESSAGES_LIMIT=12
CONTEXT_TOKEN_LIMIT=4000
GROUNDING_THRESHOLD=0.60
RAG_TOP_K=3

# Demo Mode & Database Path
DEMO_MODE=true
DATABASE_PATH=
